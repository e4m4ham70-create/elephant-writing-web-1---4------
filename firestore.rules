rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() { return signedIn() && request.auth.token.teacher == true; }

    match /writingSessions/{sessionId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read, update: if isTeacher() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if isTeacher();
      // 교사는 전체 collection query 가능
      allow list: if isTeacher();
    }
  }
}
